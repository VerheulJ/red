  <div class="hero-stats">
    <div class="stat-card">
      <div class="stat-num">100%</div>
      <div class="stat-label">Sin compromiso</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">24H</div>
      <div class="stat-label">Respuesta rápida</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">★4.9</div>
      <div class="stat-label">Valoración clientes</div>
    </div>
  </div>
</section>

<!-- BAND -->
<div class="band">
  <div class="band-item">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
    Mudanzas locales
  </div>
  <div class="band-item">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
    Transportes a medida
  </div>
  <div class="band-item">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
