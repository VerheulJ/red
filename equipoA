<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Equipo A | Mudanzas y Transportes en Andalucía</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@400;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --navy: #0d2a45;
      --navy-mid: #163a5e;
      --cyan: #00bcd4;
      --cyan-light: #4dd9ec;
      --white: #f5f9fc;
      --gray: #9bb5c9;
      --accent: #00d4b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Barlow', sans-serif;
      background: var(--navy);
      color: var(--white);
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 48px;
      background: rgba(13,42,69,0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(0,188,212,0.15);
    }

    .nav-logo {
      display: flex; align-items: center; gap: 14px;
    }

    .logo-icon {
      width: 42px; height: 42px;
      background: var(--cyan);
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      display: flex; align-items: center; justify-content: center;
      position: relative;
    }

    .logo-icon::after {
      content: '';
      position: absolute;
      width: 14px; height: 14px;
      background: var(--navy);
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      top: 14px;
    }

    .logo-text { line-height: 1; }
    .logo-text .brand { font-family: 'Bebas Neue', sans-serif; font-size: 22px; letter-spacing: 2px; color: var(--white); }
    .logo-text .sub { font-family: 'Barlow', sans-serif; font-size: 9px; letter-spacing: 3px; color: var(--cyan); text-transform: uppercase; margin-top: 2px; }

    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a {
      text-decoration: none; color: var(--gray);
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
      transition: color .2s;
    }
    .nav-links a:hover { color: var(--cyan); }

    .nav-cta {
      background: var(--cyan);
      color: var(--navy) !important;
      padding: 10px 24px;
      font-weight: 700 !important;
      border-radius: 2px;
      transition: background .2s, transform .15s !important;
    }
    .nav-cta:hover { background: var(--cyan-light) !important; transform: translateY(-1px); }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 120px 48px 80px;
      position: relative;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 70% 50%, rgba(0,188,212,0.08) 0%, transparent 70%),
        linear-gradient(160deg, #0d2a45 0%, #0a1e32 100%);
    }

    .hero-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,188,212,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,188,212,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .truck-silhouette {
      position: absolute;
      bottom: 0; right: -40px;
      width: 55%; opacity: 0.07;
      filter: blur(1px);
    }

    .hero-content { position: relative; z-index: 2; }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(0,188,212,0.12);
      border: 1px solid rgba(0,188,212,0.3);
      border-radius: 2px;
      padding: 6px 16px;
      font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
      color: var(--cyan); margin-bottom: 24px;
    }

    .hero-badge span { width: 6px; height: 6px; background: var(--cyan); border-radius: 50%; animation: pulse 1.5s infinite; }

    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(56px, 7vw, 96px);
      line-height: 0.95;
      letter-spacing: 2px;
      margin-bottom: 12px;
    }

    h1 .highlight { color: var(--cyan); }

    .hero-sub {
      font-size: 18px; font-weight: 300;
      color: var(--gray); line-height: 1.6;
      max-width: 440px; margin: 20px 0 40px;
    }

    .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--cyan); color: var(--navy);
      padding: 16px 32px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
      text-decoration: none; border-radius: 2px;
      transition: all .2s;
    }
    .btn-primary:hover { background: var(--cyan-light); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,188,212,0.3); }

    .btn-secondary {
      display: inline-flex; align-items: center; gap: 10px;
      border: 1px solid rgba(0,188,212,0.4); color: var(--cyan);
      padding: 16px 32px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
      text-decoration: none; border-radius: 2px;
      transition: all .2s;
    }
    .btn-secondary:hover { background: rgba(0,188,212,0.1); }

    .hero-stats {
      position: relative; z-index: 2;
      display: flex; flex-direction: column; gap: 32px;
      align-items: flex-end; justify-content: center;
    }

    .stat-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(0,188,212,0.15);
      border-left: 3px solid var(--cyan);
      padding: 28px 36px;
      min-width: 260px;
      animation: slideIn .6s ease both;
    }
    .stat-card:nth-child(2) { animation-delay: .1s; margin-right: 40px; }
    .stat-card:nth-child(3) { animation-delay: .2s; }
    .stat-card:nth-child(4) { animation-delay: .3s; margin-right: 40px; }

    @keyframes slideIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }

    .stat-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 48px; color: var(--cyan); line-height: 1;
    }
    .stat-label {
      font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--gray); margin-top: 4px;
    }

    /* ── BAND ── */
    .band {
      background: var(--cyan);
      padding: 20px 48px;
      display: flex; gap: 60px; align-items: center;
      overflow: hidden;
    }
    .band-item {
      display: flex; align-items: center; gap: 12px;
      white-space: nowrap;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--navy); font-weight: 700;
    }
    .band-item svg { flex-shrink: 0; }

    /* ── SERVICES ── */
    section { padding: 100px 48px; }

    .section-label {
      font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
      color: var(--cyan); margin-bottom: 12px;
    }

    .section-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(36px, 5vw, 60px);
      letter-spacing: 2px; line-height: 1;
      margin-bottom: 20px;
    }

    .section-desc {
      color: var(--gray); font-weight: 300; font-size: 16px;
      max-width: 520px; line-height: 1.7;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px; margin-top: 60px;
    }

    .service-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(0,188,212,0.1);
      padding: 48px 36px;
      position: relative; overflow: hidden;
      transition: all .3s;
      cursor: default;
    }

    .service-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--cyan);
      transform: scaleX(0); transform-origin: left;
      transition: transform .3s;
    }

    .service-card:hover { background: rgba(0,188,212,0.06); transform: translateY(-4px); }
    .service-card:hover::before { transform: scaleX(1); }

    .service-icon {
      width: 52px; height: 52px;
      background: rgba(0,188,212,0.12);
      border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 24px;
      font-size: 24px;
    }

    .service-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 20px; font-weight: 700; letter-spacing: 1px;
      text-transform: uppercase; margin-bottom: 12px;
    }

    .service-desc { color: var(--gray); font-size: 14px; line-height: 1.7; }

    /* ── HOW IT WORKS ── */
    .how-section {
      background: rgba(255,255,255,0.02);
      border-top: 1px solid rgba(0,188,212,0.1);
      border-bottom: 1px solid rgba(0,188,212,0.1);
    }

    .how-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: center; margin-top: 60px;
    }

    .steps { display: flex; flex-direction: column; gap: 0; }

    .step {
      display: flex; gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid rgba(0,188,212,0.08);
      transition: all .2s;
    }
    .step:last-child { border-bottom: none; }
    .step:hover .step-num { background: var(--cyan); color: var(--navy); }

    .step-num {
      width: 44px; height: 44px; flex-shrink: 0;
      border: 1px solid var(--cyan); border-radius: 2px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Bebas Neue', sans-serif; font-size: 20px;
      color: var(--cyan); transition: all .2s;
    }

    .step-body h4 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 16px; font-weight: 700; letter-spacing: 1px;
      text-transform: uppercase; margin-bottom: 6px;
    }
    .step-body p { font-size: 14px; color: var(--gray); line-height: 1.6; }

    .presupuesto-box {
      background: rgba(0,188,212,0.06);
      border: 1px solid rgba(0,188,212,0.25);
      padding: 48px;
      position: relative;
    }

    .presupuesto-box::after {
      content: 'PRESUPUESTO';
      position: absolute; bottom: 20px; right: 24px;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 72px; color: rgba(0,188,212,0.06);
      letter-spacing: 4px; line-height: 1;
      pointer-events: none;
    }

    .presupuesto-box h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 32px; letter-spacing: 2px;
      margin-bottom: 8px;
    }

    .presupuesto-box p { color: var(--gray); font-size: 14px; line-height: 1.6; margin-bottom: 32px; }

    .info-list { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px; }
    .info-list li {
      display: flex; align-items: flex-start; gap: 12px;
      font-size: 14px; color: var(--gray); line-height: 1.5;
    }
    .info-list li::before {
      content: '→';
      color: var(--cyan); flex-shrink: 0; font-weight: 700;
    }
    .info-list li strong { color: var(--white); }

    /* ── ZONES ── */
    .zones-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 2px; margin-top: 60px;
    }

    .zone-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(0,188,212,0.1);
      padding: 32px 28px;
      text-align: center;
      transition: all .3s;
    }

    .zone-card:hover {
      background: rgba(0,188,212,0.08);
      border-color: rgba(0,188,212,0.3);
      transform: translateY(-4px);
    }

    .zone-icon { font-size: 32px; margin-bottom: 16px; }
    .zone-name {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 18px; font-weight: 700; letter-spacing: 1px;
      text-transform: uppercase;
    }
    .zone-desc { font-size: 12px; color: var(--gray); margin-top: 6px; }

    /* ── CONTACT ── */
    .contact-section {
      background: linear-gradient(135deg, rgba(0,188,212,0.08) 0%, rgba(13,42,69,0) 100%);
      border-top: 1px solid rgba(0,188,212,0.1);
    }

    .contact-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: start; margin-top: 60px;
    }

    .contact-info h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 36px; letter-spacing: 2px; margin-bottom: 16px;
    }

    .contact-info p {
      color: var(--gray); font-size: 15px; line-height: 1.7;
      margin-bottom: 36px;
    }

    .contact-links { display: flex; flex-direction: column; gap: 16px; }

    .contact-link {
      display: flex; align-items: center; gap: 16px;
      padding: 20px 24px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(0,188,212,0.15);
      text-decoration: none; color: var(--white);
      transition: all .2s;
    }
    .contact-link:hover { background: rgba(0,188,212,0.1); border-color: var(--cyan); }

    .contact-link-icon {
      width: 44px; height: 44px; flex-shrink: 0;
      background: var(--cyan); color: var(--navy);
      display: flex; align-items: center; justify-content: center;
      border-radius: 2px; font-size: 18px; font-weight: 700;
    }

    .contact-link-text strong {
      display: block;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 15px; letter-spacing: 1px; text-transform: uppercase;
    }
    .contact-link-text span { font-size: 13px; color: var(--gray); }

    .contact-form { display: flex; flex-direction: column; gap: 16px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .form-group { display: flex; flex-direction: column; gap: 8px; }

    .form-group label {
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--cyan);
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(0,188,212,0.2);
      color: var(--white);
      padding: 14px 18px;
      font-family: 'Barlow', sans-serif; font-size: 14px;
      border-radius: 2px;
      outline: none;
      transition: border-color .2s;
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: rgba(155,181,201,0.4); }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: var(--cyan); }

    .form-group textarea { resize: vertical; min-height: 120px; }

    .form-group select option { background: var(--navy); }

    /* ── FOOTER ── */
    footer {
      background: rgba(0,0,0,0.3);
      border-top: 1px solid rgba(0,188,212,0.1);
      padding: 48px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 24px;
    }

    .footer-brand .brand { font-family: 'Bebas Neue', sans-serif; font-size: 24px; letter-spacing: 2px; }
    .footer-brand .sub { font-size: 10px; letter-spacing: 3px; color: var(--cyan); text-transform: uppercase; }

    .footer-links { display: flex; gap: 32px; }
    .footer-links a {
      text-decoration: none; color: var(--gray);
      font-size: 12px; letter-spacing: 1px; text-transform: uppercase;
      transition: color .2s;
    }
    .footer-links a:hover { color: var(--cyan); }

    .footer-copy { font-size: 12px; color: rgba(155,181,201,0.5); }

    /* ── WHATSAPP FLOAT ── */
    .wa-float {
      position: fixed; bottom: 32px; right: 32px; z-index: 200;
      width: 60px; height: 60px;
      background: #25D366;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      text-decoration: none;
      box-shadow: 0 4px 20px rgba(37,211,102,0.4);
      transition: all .2s;
      animation: bounce 2s ease infinite;
    }
    .wa-float:hover { transform: scale(1.1); box-shadow: 0 6px 30px rgba(37,211,102,0.6); }

    @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }

    .wa-float svg { width: 32px; height: 32px; fill: white; }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      nav { padding: 16px 24px; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; padding: 100px 24px 60px; }
      .hero-stats { align-items: flex-start; margin-top: 48px; }
      .stat-card:nth-child(2), .stat-card:nth-child(4) { margin-right: 0; }
      section { padding: 72px 24px; }
      .services-grid { grid-template-columns: 1fr; }
      .how-grid { grid-template-columns: 1fr; }
      .zones-grid { grid-template-columns: repeat(2,1fr); }
      .contact-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      footer { flex-direction: column; padding: 32px 24px; text-align: center; }
      .band { gap: 32px; padding: 16px 24px; flex-wrap: wrap; }
    }

    /* fade in on load */
    .hero-content > * {
      animation: fadeUp .7s ease both;
    }
    .hero-content > *:nth-child(1){animation-delay:.1s}
    .hero-content > *:nth-child(2){animation-delay:.2s}
    .hero-content > *:nth-child(3){animation-delay:.3s}
    .hero-content > *:nth-child(4){animation-delay:.4s}
    @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">
    <div class="logo-icon"></div>
    <div class="logo-text">
      <div class="brand">EQUIPO A</div>
      <div class="sub">Mudanzas y Transportes</div>
    </div>
  </div>
  <ul class="nav-links">
    <li><a href="#servicios">Servicios</a></li>
    <li><a href="#como-funciona">Cómo funciona</a></li>
    <li><a href="#zonas">Zonas</a></li>
    <li><a href="#contacto" class="nav-cta">Presupuesto</a></li>
  </ul>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>

  <div class="hero-content">
    <div class="hero-badge">
      <span></span>
      Disponibles en Andalucía
    </div>
